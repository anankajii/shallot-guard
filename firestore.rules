rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function admin() { return signedIn() && user().data.role == 'admin'; }
    function owner() { return signedIn() && resource.data.userId == request.auth.uid; }
    function creatingOwn() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    function unchangedAccessFields() { return request.resource.data.userId == resource.data.userId && request.resource.data.role == resource.data.role && request.resource.data.plan == resource.data.plan; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if request.auth.uid == uid && request.resource.data.role == 'farmer' && request.resource.data.plan == 'free';
      allow update: if request.auth.uid == uid && request.resource.data.role == resource.data.role && request.resource.data.plan == resource.data.plan;
      allow update, delete: if admin();
    }
    match /{collection}/{id} {
      allow read: if admin() || owner() || (collection in ['knowledgeContent', 'products', 'marketPrices'] && signedIn());
      allow create: if admin() || creatingOwn();
      allow update, delete: if admin() || (owner() && unchangedAccessFields());
    }
    match /auditLogs/{id} { allow read: if admin(); allow create: if signedIn(); allow update, delete: if false; }
  }
}
